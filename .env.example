# Copie para .env (que está no .gitignore) e preencha. NUNCA commite valores reais.

# Porta HTTP (o Render define sozinho)
PORT=3000

# Segredo para assinar o login (JWT). Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase. Para desenvolvimento e staging use um PROJETO SEPARADO do de produção.
SUPABASE_URL=
SUPABASE_KEY=

# Origem permitida no CORS (URL pública da PMS, sem barra no final)
ALLOWED_ORIGIN=http://localhost:3000

# Checagem de conflito de quarto no servidor:
#   warn    = só registra no log e grava (padrão; use primeiro em produção)
#   enforce = recusa com HTTP 409 ROOM_CONFLICT
#   off     = desliga (comportamento antigo)
AVAILABILITY_CHECK=warn

# Tokens das URLs de calendário exportadas (/calendar/...). Valores secretos.
# Não troque em produção sem antes inventariar os links cadastrados no Airbnb/Booking.
CALENDAR_TOKEN=
ICAL_TOKEN=
